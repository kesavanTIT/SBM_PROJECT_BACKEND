generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model Staff {
  id             Int      @id @default(autoincrement())
  staffId        String   @unique
  name           String
  joinDate       String
  phone          String
  whatsappNumber String?
  email          String   @unique
  address        String
  city           String
  state          String
  zipCode        String
  photoUrl       String?
  status         String   @default("Present")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendances    Attendance[]

  @@map("staff")
}

model Attendance {
  id           Int       @id @default(autoincrement())
  staffId      Int
  staff        Staff     @relation(fields: [staffId], references: [id])
  date         String
  checkIn      DateTime
  checkOut     DateTime?
  totalHours   String?
  status       String?   // "On Time", "Late" etc.
  pendingHours String?
  overtimeHours String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime  @default(now())

  @@unique([staffId, date])
  @@map("attendance")
}
