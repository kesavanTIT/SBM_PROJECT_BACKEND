generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model Branch {
  id             Int      @id @default(autoincrement())
  name           String
  address        String
  latitude       Float
  longitude      Float
  geofenceRadius Int      @default(300)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  staff          Staff[]

  @@map("branches")
}

model Staff {
  id             Int      @id @default(autoincrement())
  staffId        String   @unique
  name           String
  joinDate       String
  phone          String
  whatsappNumber String?
  email          String   @unique
  address        String
  city           String
  state          String
  zipCode        String
  photoUrl       String?
  aadhaarNumber  String?
  aadhaarPhotoUrl String?
  aadhaarPhotoBackUrl String?
  status         String   @default("Present")
  branchId       Int?
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendances    Attendance[]

  @@map("staff")
}

model Attendance {
  id            Int       @id @default(autoincrement())
  staffId       Int
  staff         Staff     @relation(fields: [staffId], references: [id])
  branchId      Int?
  branchName    String?
  date          String
  checkIn       DateTime
  checkOut      DateTime?
  totalHours    String?
  status        String?   // "On Time", "Late" etc.
  pendingHours  String?
  overtimeHours String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime  @default(now())

  @@unique([staffId, date])
  @@map("attendance")
}
